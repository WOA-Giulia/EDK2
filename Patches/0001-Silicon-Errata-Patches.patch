+STATIC
+BOOLEAN
+PatchGicIrmInstruction (
+  IN EFI_PHYSICAL_ADDRESS Base,
+  IN UINTN                Length,
+  IN EFI_PHYSICAL_ADDRESS InstrAddr,
+  IN UINT32               Rt)
+{
+  CONST UINTN StubWords = 27;
+  EFI_PHYSICAL_ADDRESS Cave = FindExecutableSlack (Base, Length, InstrAddr, StubWords * ARM64_INSTRUCTION_LENGTH);
+  if (Cave == 0) {
+    return FALSE;
+  }
+
+  INT64  BackDelta = (INT64)(InstrAddr + ARM64_INSTRUCTION_LENGTH) - (INT64)(Cave + 26 * ARM64_INSTRUCTION_LENGTH);
+  UINT32 BackBr    = 0x14000000U | (UINT32)((BackDelta / 4) & 0x03FFFFFFU);
+
+  // LR/NZCV/register-preserving GICv3 IRM broadcast SGI emulation for Aff1 = 0..7, Aff0 = 0
+  UINT32 Stub[27] = {
+    0xA9BD53F3U,                       // 00: stp  x19, x20, [sp, #-0x30]!
+    0xA9015BF5U,                       // 04: stp  x21, x22, [sp, #0x10]
+    0xD53B4213U,                       // 08: mrs  x19, nzcv
+    0xF90013F3U,                       // 0C: str  x19, [sp, #0x20]
+    0xB6400200U | Rt,                  // 10: tbz  xRt, #40, #0x50
+    0x9257F816U | (Rt << 5),           // 14: and  x22, xRt, #0xfffffeffffffffff
+    0xB24002D6U,                       // 18: orr  x22, x22, #1
+    0xD53800B5U,                       // 1C: mrs  x21, mpidr_el1
+    0xD3482EB5U,                       // 20: ubfx x21, x21, #8, #4
+    0xD2800014U,                       // 24: movz x20, #0
+    0xEB15029FU,                       // 28: cmp  x20, x21
+    0x540000A0U,                       // 2C: b.eq #0x40
+    0xD370BE93U,                       // 30: lsl  x19, x20, #16
+    0xAA160273U,                       // 34: orr  x19, x19, x22
+    0xD518CBB3U,                       // 38: msr  icc_sgi1r_el1, x19
+    0xD5033F9FU,                       // 3C: dsb  sy
+    0x91000694U,                       // 40: add  x20, x20, #1
+    0xF100229FU,                       // 44: cmp  x20, #8
+    0x54FFFF03U,                       // 48: b.lo #0x28
+    0x14000003U,                       // 4C: b    #0x58
+    0xD518CBA0U | Rt,                  // 50: msr  icc_sgi1r_el1, xRt
+    0xD5033F9FU,                       // 54: dsb  sy
+    0xF94013F3U,                       // 58: ldr  x19, [sp, #0x20]
+    0xD51B4213U,                       // 5C: msr  nzcv, x19
+    0xA9415BF5U,                       // 60: ldp  x21, x22, [sp, #0x10]
+    0xA8C353F3U,                       // 64: ldp  x19, x20, [sp], #0x30
+    BackBr                             // 68: b    (InstrAddr + 4)
+  };
+
+  for (UINTN i = 0; i < StubWords; i++) {
+    ARM64_INSTRUCTION (Cave + i * ARM64_INSTRUCTION_LENGTH) = Stub[i];
+  }
+
+  WriteBackInvalidateDataCacheRange ((VOID *)Cave, sizeof (Stub));
+  InvalidateInstructionCacheRange   ((VOID *)Cave, sizeof (Stub));
+
+  INT64  Offset = (INT64)Cave - (INT64)InstrAddr;
+  UINT32 BrIns  = 0x14000000U | (UINT32)((Offset / 4) & 0x03FFFFFFU);
+  ARM64_INSTRUCTION (InstrAddr) = BrIns;
+
+  WriteBackInvalidateDataCacheRange ((VOID *)InstrAddr, ARM64_INSTRUCTION_LENGTH);
+  InvalidateInstructionCacheRange   ((VOID *)InstrAddr, ARM64_INSTRUCTION_LENGTH);
+
+  return TRUE;
 }
 #endif
 
