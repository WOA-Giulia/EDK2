+  UINTN IrmPatched   = 0;
+  UINTN TotalPatched = 0;
+
+  EFI_IMAGE_SECTION_HEADER *Sec = (EFI_IMAGE_SECTION_HEADER *)((UINT8 *)&Nt->OptionalHeader + Nt->FileHeader.SizeOfOptionalHeader);
+  for (UINT16 s = 0; s < Nt->FileHeader.NumberOfSections; s++) {
+    if (!(Sec[s].Characteristics & EFI_IMAGE_SCN_MEM_EXECUTE)) {
+      continue;
+    }
+
+    EFI_PHYSICAL_ADDRESS SecBase = Base + Sec[s].VirtualAddress;
+    UINTN                SecSize = Sec[s].Misc.VirtualSize;
+    if (SecBase < Base || SecBase >= Base + Length) {
+      continue;
+    }
+    if (SecBase + SecSize > Base + Length) {
+      SecSize = (Base + Length) - SecBase;
+    }
+
+    for (EFI_PHYSICAL_ADDRESS Current = SecBase; Current + ARM64_INSTRUCTION_LENGTH <= SecBase + SecSize; Current += ARM64_INSTRUCTION_LENGTH) {
+      UINT32 Instruction = ARM64_INSTRUCTION (Current);
+      UINT32 Masked      = Instruction & ~0x1FU;
+      UINT32 Rt          = Instruction & 0x1FU;
+      BOOLEAN Patched    = FALSE;
+
+#if HAS_GIC_V3_WITHOUT_IRM_FLAG_SUPPORT_ERRATA == 1
+      // msr icc_sgi1r_el1, xRt -> register-preserving IRM broadcast emulation
+      if (Masked == 0xD518CBA0U) {
+        if (PatchGicIrmInstruction (Base, Length, Current, Rt)) {
+          IrmPatched++;
+          continue;
+        }
+      }
 #endif
+
+      // mrs x?, actlr_el1 | amcntenset0_el0 | amcgcr_el0 | amcntenclr0_el0 | amcntenset1_el0 | amcntenclr1_el0 | mdscr_el1 | oslsr_el1 -> mov x?, #0
+      if (Masked == 0xD5381020 || Masked == 0xD53BD2A0 || Masked == 0xD53BD240 ||
+          Masked == 0xD53BD280 || Masked == 0xD53BD320 || Masked == 0xD53BD300 ||
+          Masked == 0xD5300240 || Masked == 0xD5301180) {
+        ARM64_INSTRUCTION (Current) = 0xD2800000 | Rt;
+        Patched = TRUE;
+      }
+      // msr actlr_el1 | amcntenset0_el0 | amcntenclr0_el0 | oslar_el1 | mdscr_el1 -> NOP
+      else if (Masked == 0xD5181020 || Masked == 0xD51BD2A0 || Masked == 0xD51BD280 ||
+               Masked == 0xD5101080 || Masked == 0xD5100240) {
+        ARM64_INSTRUCTION (Current) = 0xD503201F;
+        Patched = TRUE;
+      }
+
+      if (Patched) {
+        TotalPatched++;
+        WriteBackInvalidateDataCacheRange ((VOID *)Current, ARM64_INSTRUCTION_LENGTH);
+        InvalidateInstructionCacheRange   ((VOID *)Current, ARM64_INSTRUCTION_LENGTH);
+      }
+    }
+  }
+
+  if (TotalPatched > 0 || IrmPatched > 0) {
+    DEBUG ((EFI_D_WARN, "[KEP] Patched PE 0x%p (Patches: %u, DAIFClr: %u, IRM: %u)\n", Base, (UINT32)TotalPatched, (UINT32)DaifPatched, (UINT32)IrmPatched));
+  }
 }
 
