+STATIC
+BOOLEAN
+PatchGicIrmInstruction (
+  IN EFI_PHYSICAL_ADDRESS Base,
+  IN UINTN                Length,
+  IN EFI_PHYSICAL_ADDRESS InstrAddr,
+  IN UINT32               Rt)
+{
+  CONST UINTN StubWords = 27;
